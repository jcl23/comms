{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Run Frontend",
        "type": "shell",
        "command": "npm run dev",
        "options": {
          "cwd": "${workspaceFolder}/frontend/comms",
          "shell": {
            "executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
          }
        },
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "showReuseMessage": false,
          "clear": false
        },
        "problemMatcher": []
      },
      {
        "label": "Run Backend",
        "type": "shell",
        "command": "nodemon src/server.ts",
        "options": {
          "cwd": "${workspaceFolder}/backend",
          "shell": {
            "executable": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
          }
        },
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "showReuseMessage": false,
          "clear": false
        },
        "problemMatcher": []
      },
      {
        "label": "Run All",
        "dependsOn": ["Run Frontend", "Run Backend"],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      }
    ]
  }
  