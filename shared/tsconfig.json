{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "outDir": "./dist",
      "baseUrl": "./",
      "paths": {
        "*": ["node_modules/*"]
      },
      "strict": true,
      "esModuleInterop": true,
      "composite": true,
      "resolveJsonModule": true,
    },
    "include": ["**/*.ts", "**/*.json"],
    "exclude": ["node_modules", "dist"]
  }