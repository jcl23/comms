{
    "compilerOptions": {
      "target": "ES6",
      "esModuleInterop": true,
      "module": "CommonJS",
      "strict": true,
      "skipLibCheck": true,
      "outDir": "./dist",
      "rootDir": "./src",
      "baseUrl": "./src",
      "noImplicitAny": false,
      "resolveJsonModule": true,
      "paths": {
        "*": ["node_modules/*"],
        "@shared/*": ["../../shared/dist/*"]
      }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"],
    "references": [
      { "path": "../shared/dist" }
    ]
}